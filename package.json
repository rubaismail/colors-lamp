{
  "name": "colors-lamp",
  "version": "1.0.0",
  "private": true,
  "description": "Lint tooling for the COLORS LAMP application",
  "scripts": {
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:html": "htmlhint \"**/*.html\" --ignore \"node_modules/**\"",
    "lint:css": "stylelint \"**/*.css\" --ignore-pattern \"node_modules/**\" --max-warnings 0",
    "lint:js": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "htmlhint": "1.9.2",
    "stylelint": "16.26.1",
    "stylelint-config-standard": "36.0.1"
  }
}
