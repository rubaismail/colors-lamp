@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam activityBackgroundColor #F2F2F2
skinparam activityBorderColor #777777
skinparam activityDiamondBackgroundColor #F2F2F2
skinparam activityDiamondBorderColor #777777
skinparam ArrowColor #333333
title COLORS — Activity Diagram
start
:User opens the app;
:Enter login credentials;
:Check credentials against Users table;
while (Credentials invalid?) is (yes)
  :Show login error;
  :Re-enter login credentials;
  :Check credentials against Users table;
endwhile (no)
:Save login cookie;
:Load color management page;
repeat
  if (User wants to search?) then (yes)
    :Enter a color name to search;
    :Query Colors table\nfor this user;
    :Display matching results\nwhen returned;
  else (no)
    if (User wants to add a color?) then (yes)
      :Enter color name;
      :Insert record into Colors\nwith the user's ID;
      :Show confirmation message;
    else (no)
      :Remain on color management page;
    endif
  endif
repeat while (Continue using the app?) is (yes) not (no: Log Out)
:Clear login cookie and user state;
:Return to login page;
stop
legend bottom
Existing lab account required; no registration flow.
High-level normal flow; error-handling scope is documented in README.md.
endlegend
@enduml
